# Frontend (Next.js) Environment Variables
# Copy this file to .env.local and fill in your actual values

# Next.js Authentication
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# API Configuration
# Public, browser-visible backend URL (used by NextAuth login).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-only backend URL used by the /api/proxy Route Handler. Set this to the
# private/internal address in production (e.g. http://api:8000); falls back to
# NEXT_PUBLIC_API_URL when unset.
API_URL=http://localhost:8000

# Application Settings
NODE_ENV=development
PORT=3000

# Error tracking (Sentry) — issue #485
# Server-only, and the SAME variable the API and Celery worker read. Client
# error boundaries POST to the same-origin /api/monitoring route, which forwards
# a Sentry envelope using this DSN — so the DSN never reaches the browser and the
# strict-dynamic CSP needs no connect-src exception.
# Unset means a hard no-op: local dev and CI never phone home.
SENTRY_DSN=
# Optional; tags client events so they filter alongside the API's. Falls back to
# NODE_ENV.
SENTRY_ENVIRONMENT=
