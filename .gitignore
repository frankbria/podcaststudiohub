.pypirc

specs/

# But allow E2E test specs
!tests/e2e/specs/

# Playwright auth state (generated by global-setup)
tests/e2e/.auth/

*.whl
*.wheels

# Exclude aliases file
alias.sh

local_*.ipynb
*.ipynb_checkpoints

# Python-specific ignores
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
env/
.env

# IDE-specific files
.vscode/
.idea/
*.swp
*.swo

# OS-specific files
.DS_Store
Thumbs.db

# Project-specific ignores
attachments/

# Logs
*.log

# Temporary files
*.tmp

# Compiled Python files
*.pyc

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/

# Exception: Allow Next.js lib directory for shadcn/ui components
!apps/web/src/lib/
# Exception: Allow frontend unit test lib directory
!apps/web/__tests__/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# But allow Playwright test specs
!tests/**/*.spec.ts

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
coverage/
test-results/
playwright-report/

# Runtime data — generated audio/transcripts. Already-committed sample files
# under data/audio stay tracked (git keeps tracked files even when ignored);
# only new runtime output is ignored. Do NOT add !/data/audio/ — that would
# re-track generated podcasts, the cruft this rule exists to prevent.
/data/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

# Poetry
poetry.lock
.poetry/

# Poetry
.venv/
dist/

# Python
*.pyc
__pycache__/
*.egg-info/

# Node.js / Next.js (for apps/web/)
node_modules/
.next/
.turbo/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts

# npm/pnpm/yarn (package-lock.json is committed for CI reproducibility)
pnpm-lock.yaml
yarn.lock
.pnpm-debug.log*
.yarn/

# TypeScript
*.tsbuildinfo

# Apps directory build artifacts
apps/web/dist/
apps/web/build/
apps/api/dist/

# Podcastfy CLI - installed as package, not vendored
podcastfy/

# Large notebook files
podcastfy.ipynb
usage/examples.ipynb
# Local demo artifacts (issue-lifecycle demo verification — never committed)
demo.md
demo_*.md
demo_*_runner.py

# Local assistant memory artifacts
apps/*/.claude/
